# Supabase (Handld Home database)
HANDLD_SUPABASE_URL=https://xrjzgsvqrobvkkerfext.supabase.co
HANDLD_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Twilio Configuration. TWILIO_PHONE_NUMBER is the one shared Handld sending
# number (approved 10DLC campaign); always send with From = this number.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Owner's phone for internal alerts (tech declined a job, tech did not confirm
# by the deadline). These skip the STOP footer and texting hours. If unset the
# app falls back to the legacy owner line so alerts keep flowing.
OWNER_ALERT_PHONE=+1XXXXXXXXXX

# Vercel Blob Storage (for photo uploads)
# This is auto-configured when you connect Blob storage in Vercel dashboard
# Go to your project > Storage > Connect Database > Blob
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# PRIVATE Vercel Blob store for W-9s (SSN/EIN). Must be a separate store
# created with access "private", connected with env var prefix PRIVATE_BLOB.
# W-9 uploads return 503 until this is set; they never fall back to public.
PRIVATE_BLOB_READ_WRITE_TOKEN=your_private_blob_read_write_token
# Shown to techs if W-9 upload is unavailable ("Please email your W-9 to ...")
W9_CONTACT_EMAIL=

# Admin dashboard key (?key=... on the dashboard, x-admin-key on admin APIs).
# No fallback: if unset, the admin dashboard and every /api/admin/* route refuse.
ADMIN_SECRET_KEY=your_admin_secret_key

# Vercel cron auth. Vercel sends "Authorization: Bearer $CRON_SECRET" to cron
# routes once this is set. Cron routes refuse every request when it is unset.
CRON_SECRET=generate_a_long_random_string
